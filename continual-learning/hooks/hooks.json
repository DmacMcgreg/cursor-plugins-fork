{
  "description": "Continual Learning stop hook: decides when transcript mining should run.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/continual-learning-stop.mjs"],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
