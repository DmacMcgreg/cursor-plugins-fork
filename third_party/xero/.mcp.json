{
  "mcpServers": {
    "xero": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@xeroapi/xero-mcp-server@latest"
      ],
      "env": {
        "XERO_CLIENT_ID": "${user_config.xero_client_id}",
        "XERO_CLIENT_SECRET": "${user_config.xero_client_secret}"
      }
    }
  }
}
