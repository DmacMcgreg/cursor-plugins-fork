{
  "description": "Advisor hooks: track file edits, capture the last assistant message, nudge a pre-completion consult at Stop, and record finished advisor consults.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "bash",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/mark-pending.sh"],
            "timeoutMs": 5000
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "process",
            "command": "bash",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/record-consult.sh"],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "bash",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/capture-response.sh"],
            "timeoutMs": 5000
          },
          {
            "type": "process",
            "command": "bash",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/stop-hook.sh"],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
